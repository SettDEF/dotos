[package]
name = "dotos"
version = "0.1.0"
edition = "2021"
description = "Tasks for the ii desktop — CLI and JSON backend for the QML app"

[dependencies]
icalcore = { path = "../../icalcore" }
chrono = { version = "0.4", default-features = false, features = ["clock", "std", "serde"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
